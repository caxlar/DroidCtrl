    "wireless_debugging_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone/tablet: Wireless Debugging must be ON and port is NOT 5555 but random. Easiest: tap Pair on the right. Android TV usually uses IP:5555."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon/tablet: Kablosuz hata ayıklama açık olmalı ve port 5555 değil, rastgele bir sayıdır. En kolayı sağdaki listeden Eşleştir'e basmak. Android TV'lerde genelde IP:5555 kullanılır."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Teléfono/tablet: Depuración inalámbrica debe estar ON y el puerto NO es 5555 sino aleatorio. Lo más fácil: toque Emparejar a la derecha. Android TV suele usar IP:5555."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机/平板：无线调试必须开启，端口不是 5555 而是随机的。最简单：点击右侧配对。Android TV 通常用 IP:5555。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Handy/Tablet: Wireless Debugging muss AN sein, Port ist NICHT 5555 sondern zufällig. Einfach: rechts auf Koppeln tippen. Android TV nutzt meist IP:5555."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefono/tablet: Debug wireless deve essere ATTIVO e la porta NON è 5555 ma casuale. Più facile: tocca Associa a destra. Android TV di solito usa IP:5555."
          }
        }
      }
    },
