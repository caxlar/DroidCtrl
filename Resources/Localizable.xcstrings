    "control_with_adb_scrcpy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control TV, phone and tablet from your Mac with adb + embedded scrcpy client."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "adb + gömülü scrcpy istemcisi ile televizyon, telefon ve tabletinizi Mac'ten yönetin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla TV, teléfono y tablet desde tu Mac con adb + cliente scrcpy integrado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 adb + 嵌入式 scrcpy 客户端从 Mac 控制电视、手机和平板。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuere TV, Handy und Tablet von deinem Mac mit adb + eingebettetem scrcpy-Client."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla TV, telefono e tablet dal tuo Mac con adb + client scrcpy integrato."
          }
        }
      }
    },
    "security_local_only": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App runs on LOCAL NETWORK only. ADB is full device control; must not be exposed to internet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama yalnızca YEREL AĞ üzerinden çalışır. ADB tam cihaz kontrolü demektir; internete açılmamalıdır."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app solo funciona en RED LOCAL. ADB es control total del dispositivo; no debe exponerse a internet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用仅在本地网络运行。ADB 是完全设备控制；不应暴露给互联网。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App läuft nur im LOKALEN NETZWERK. ADB ist volle Gerätesteuerung; darf nicht ins Internet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app funziona solo su RETE LOCALE. ADB è controllo completo del dispositivo; non esporre a internet."
          }
        }
      }
    },
    "device_protection": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview doesn't stay on — you start it, you stop it. Temperature rises → auto-stop. App closes → stream stops."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önizleme açık kalmaz — siz açarsınız, siz kapatırsınız. Sıcaklık yükselirse otomatik durur, uygulama kapanınca yayın kesilir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista previa no se queda abierta — tú la abres, tú la cierras. Temperatura sube → auto-detiene. App cierra → stream para."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览不会持续开启 — 你开启，你关闭。温度升高 → 自动停止。应用关闭 → 流停止。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschau bleibt nicht an — du startest, du stoppst. Temperatur steigt → Auto-Stopp. App schließt → Stream stoppt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'anteprima non resta accesa — la avvii, la fermi. Temperatura sale → auto-stop. App chiusa → stream fermo."
          }
        }
      }
    },
